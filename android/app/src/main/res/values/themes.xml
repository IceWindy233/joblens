<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      不显示原生标题栏：设置页自带顶部常驻栏。状态栏、导航栏区域显示页面底色（DESIGN.md 的 canvas），
      图标颜色随深浅色切换（values-night 覆盖）。
    -->
    <style name="Theme.JobLens" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
</resources>
